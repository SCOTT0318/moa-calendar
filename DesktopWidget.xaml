<Window x:Class="Gather.DesktopWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="모아 미니 위젯" Width="340" Height="430" MinWidth="300" MinHeight="300" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" Background="#F3F6FA" Foreground="#17283F" Icon="/Assets/moa.ico">
 <Border Background="#F3F6FA" BorderBrush="#9BAEC5" BorderThickness="1" Padding="18">
  <DockPanel>
   <Grid DockPanel.Dock="Top" Margin="0,0,0,14" MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="모아 · 오늘" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/><Button Grid.Column="1" Content="닫기" Click="Close_Click" Padding="8,4" AutomationProperties.Name="미니 위젯 닫기"/></Grid>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock x:Name="DateLabel" Foreground="#536880"/><TextBlock x:Name="MailCount" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="모아 열기" Click="Open_Click" Padding="10,6"/><CheckBox x:Name="PinOnTop" Content="항상 위" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Pin_Changed" Unchecked="Pin_Changed"/></WrapPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Events"/></ScrollViewer>
  </DockPanel>
 </Border>
</Window>
