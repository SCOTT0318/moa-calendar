<Window x:Class="Gather.EventEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="일정" Width="480" Height="600" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Padding="30" Background="White"><StackPanel><TextBlock x:Name="EditorTitle" Text="새 일정" FontSize="25" FontWeight="Bold"/><TextBlock Text="이 PC에 저장됩니다." Foreground="#68788E" Margin="0,10,0,24"/><TextBlock Text="일정 제목" Margin="0,0,0,7"/><TextBox x:Name="TitleInput" MaxLength="120" AutomationProperties.Name="일정 제목"/><TextBlock Text="날짜" Margin="0,17,0,7"/><DatePicker x:Name="DateInput" Padding="8" AutomationProperties.Name="일정 날짜"/><Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="시작 (24시간제)" Margin="0,0,0,7"/><TextBox x:Name="StartInput" Text="09:00" AutomationProperties.Name="시작 시간"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="종료 (24시간제)" Margin="0,0,0,7"/><TextBox x:Name="EndInput" Text="10:00" AutomationProperties.Name="종료 시간"/></StackPanel></Grid><TextBlock Text="장소 또는 메모" Margin="0,17,0,7"/><TextBox x:Name="LocationInput" MaxLength="200" AutomationProperties.Name="장소"/><TextBlock x:Name="ErrorText" Foreground="#B75447" MinHeight="45" Margin="0,13,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True"/><Button x:Name="SaveEventButton" Content="일정 저장" Style="{StaticResource Primary}" Click="Save_Click" IsDefault="True"/></StackPanel></StackPanel></Border>
</Window>
