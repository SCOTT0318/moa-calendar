<Window x:Class="Gather.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/moa.ico" Title="모아 · 메일과 일정" Width="1440" Height="900" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Background="#F3F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#152C48" Padding="20,28,14,20">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="모아" FontSize="32" FontWeight="Bold" Foreground="White"/>
     <Button x:Name="InboxNav" Content="통합 메일함" Click="Inbox_Click" Style="{StaticResource Primary}" Margin="0,20,0,8" HorizontalContentAlignment="Left"/>
     <Button x:Name="CalendarNav" HorizontalContentAlignment="Left" Content="캘린더" Click="Calendar_Click" Background="#223C5B" Foreground="White" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" HorizontalContentAlignment="Left" Content="설정" Click="Settings_Click" Background="#223C5B" Foreground="White" Margin="0,0,0,30"/>
     <TextBlock x:Name="MailAccountHeading" Text="내 메일 계정" Foreground="#A8BCD5" FontSize="11" Margin="6,0,0,10"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="내 일정은 이 PC에 저장됩니다." Foreground="#B4C7DF" FontSize="11" Margin="6,18,6,0"/>
    <ListBox x:Name="AccountList" SelectionChanged="Account_Changed" Foreground="White" AutomationProperties.Name="내 메일 계정">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="AccountRow" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="AccountRow" Property="Background" Value="#294B70"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AccountRow" Property="BorderBrush" Value="#8EC5FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AccountRow" Property="BorderBrush" Value="#567BA4"/><Setter TargetName="AccountRow" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="9,10"><TextBlock Text="{Binding Label}" Foreground="#D6E4F6" FontWeight="SemiBold"/><TextBlock Text="{Binding ProviderLabel}" Foreground="#9FB5CE" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,24,24,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="통합 메일함" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="여러 계정의 소식을, 한 번에." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Grid>
   <Border x:Name="MailNotice" Grid.Row="1" Visibility="Collapsed" Background="#E8EFFB" BorderBrush="#D5E1F5" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,0,0,18"><TextBlock x:Name="MailNoticeText" Text="설정에서 계정을 추가하세요." Foreground="#42608C" FontSize="12"/></Border>
   <Grid x:Name="MailPanel" Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top"><Button x:Name="MailRefresh" Content="메일 새로고침" Click="CalendarRefresh_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,12" IsEnabled="False"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="메일 검색" ToolTip="제목, 보낸 사람, 본문 검색"/><TextBlock Text="제목 · 보낸 사람 · 본문 검색" FontSize="11" Foreground="{StaticResource Muted}" Margin="3,5,0,13"/>
       <WrapPanel Margin="0,0,0,12"><Button x:Name="AllFilter" Content="전체" Click="All_Click" Padding="12,7"/><Button x:Name="UnreadFilter" Content="안 읽음" Click="Unread_Click" Padding="12,7"/><Button x:Name="StarredFilter" Content="중요" Click="Starred_Click" Padding="12,7"/></WrapPanel>
       <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" FontSize="11" Margin="3,0,0,12"/>
      </StackPanel>
      <TextBlock x:Name="EmptyMail" DockPanel.Dock="Bottom" Text="표시할 메일이 없습니다. 검색어나 필터를 바꿔 보세요." Foreground="{StaticResource Muted}" Margin="8" Visibility="Collapsed"/>
      <ListBox x:Name="MessageList" SelectionChanged="Message_Changed" AutomationProperties.Name="메일 목록">
       <ListBox.ItemTemplate><DataTemplate><Border Padding="12,13" BorderBrush="#E9EDF3" BorderThickness="0,0,0,1"><StackPanel><Grid><TextBlock Text="{Binding Sender}" FontWeight="Bold" Margin="0,0,85,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,9,0,6"/><TextBlock Text="{Binding Preview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding ReadLabel}" FontSize="11" Foreground="#42608C"/><TextBlock Text="{Binding StarLabel}" Margin="12,0,0,0" Foreground="#C29525"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock x:Name="ReaderSubject" Text="메일을 선택해 주세요" FontSize="23" FontWeight="Bold" Margin="0,0,0,22"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,20"><TextBlock x:Name="ReaderSender" FontWeight="SemiBold"/><TextBlock x:Name="ReaderMeta" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,16"/><WrapPanel><Button x:Name="ReadButton" Content="읽음으로 표시" Click="Read_Click" Padding="13,8"/><Button x:Name="StarButton" Content="☆ 중요 표시" Click="Star_Click" Padding="13,8"/></WrapPanel><Border Height="1" Background="#E7EDF5" Margin="0,22,0,0"/></StackPanel>
      <TextBox x:Name="ReaderBody" Grid.Row="2" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메일 본문"/>

     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="CalendarPanel" Grid.Row="2" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MonthTitle" FontSize="22" FontWeight="Bold"/><Button x:Name="NewEventButton" Grid.Column="1" Content="＋ 새 일정" Click="NewEvent_Click" Padding="12,8" Style="{StaticResource Primary}" Margin="10,0,0,0"/></Grid><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="‹" Click="PreviousMonth_Click" Padding="13,6" AutomationProperties.Name="이전 달"/><Button x:Name="CalendarRefresh" Content="↻" Click="CalendarRefresh_Click" AutomationProperties.Name="캘린더 새로고침" Padding="10,6" IsEnabled="False"/><Button Content="오늘" Click="Today_Click" Padding="13,6"/><Button Content="›" Click="NextMonth_Click" Padding="13,6" AutomationProperties.Name="다음 달"/></StackPanel></Grid></StackPanel><UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,12"><TextBlock Text="일" HorizontalAlignment="Center" Foreground="#CB6B70"/><TextBlock Text="월" HorizontalAlignment="Center"/><TextBlock Text="화" HorizontalAlignment="Center"/><TextBlock Text="수" HorizontalAlignment="Center"/><TextBlock Text="목" HorizontalAlignment="Center"/><TextBlock Text="금" HorizontalAlignment="Center"/><TextBlock Text="토" HorizontalAlignment="Center" Foreground="#5685CA"/></UniformGrid><UniformGrid x:Name="CalendarDays" Columns="7" Rows="6"/></DockPanel></Border>
    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="AgendaTitle" FontSize="19" FontWeight="Bold" Margin="0,0,0,20"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AgendaItems"/></ScrollViewer></DockPanel></Border>
   </Grid>
   <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="내 계정" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Google 2개 이상, 네이버·하이웍스도 여러 계정을 추가할 수 있습니다. 각 계정에서 메일·일정을 따로 선택하세요." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/>
      <WrapPanel><Button x:Name="GoogleCalendarConnect" Content="Google 계정 추가" Click="GoogleCalendarConnect_Click" Style="{StaticResource Primary}"/><Button x:Name="NaverCalendarConnect" Content="네이버 계정 추가" Click="NaverCalendarConnect_Click"/><Button x:Name="HiworksConnect" Content="하이웍스 계정 추가" Click="HiworksConnect_Click"/></WrapPanel>
      <Expander Header="처음 연결할 때" Margin="0,16,0,12"><StackPanel Margin="0,10,0,0">
       <TextBlock Text="Google: Google Cloud에서 Gmail API·Calendar API를 활성화하고 OAuth 동의 화면과 테스트 사용자를 설정하세요. 데스크톱 앱용 클라이언트 JSON을 한 번 선택하면, 다음 계정 추가 시 같은 설정으로 브라우저에서 다른 계정을 고를 수 있습니다." Foreground="{StaticResource Muted}"/>
       <TextBlock Text="네이버: 메일의 IMAP 사용 설정과 2단계 인증·앱 비밀번호가 필요합니다. 캘린더 CalDAV는 Windows 시험 지원입니다. 하이웍스: 외부 메일 사용 허용과 전용 메일 비밀번호가 필요하며 POP3로 받은 편지함을 읽습니다." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
       <TextBlock Text="메일은 계정별 최근 50통을 읽습니다. 앱 시작 시 기존 메일에는 알림을 띄우지 않고, 이후 2분마다 확인한 새 메일에 알립니다. 서버 원본·읽음·별표·일정은 바꾸지 않습니다." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Expander>
      <ItemsControl x:Name="CalendarConnections"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="연결 해제" Tag="{Binding Id}" Click="DisconnectCalendar_Click" Padding="12,7"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
     <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="알림과 실행" FontSize="20" FontWeight="Bold"/><Button Content="미니 위젯 열기" Click="Widget_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="오늘 일정과 안 읽은 메일 수를 작은 창으로 봅니다. 창 위쪽을 끌어 이동하고 항상 위를 선택할 수 있습니다. Windows Win+W 위젯 보드와는 별도 기능입니다." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
      <WrapPanel Margin="0,16,0,12"><CheckBox x:Name="ReminderEnabled" Content="일정 알림" Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed" Margin="0,0,24,0"/><CheckBox x:Name="NewMailEnabled" Content="새 메일 알림" Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed"/></WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="일정 시작" VerticalAlignment="Center"/><TextBox x:Name="ReminderLead" Width="55" Margin="10,0" MaxLength="2" TextChanged="ReminderLead_Changed" AutomationProperties.Name="일정 알림 분"/><TextBlock Text="분 전 (0~60)" VerticalAlignment="Center"/><Button Content="알림 테스트" Click="TestNotification_Click" Margin="20,0,0,0"/></StackPanel>
      <CheckBox x:Name="TrayOnClose" Content="창을 닫아도 트레이에서 계속 확인" Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed"/>
      <TextBlock Text="완전히 종료하려면 트레이 아이콘의 ‘종료’를 선택하세요. 앱이 종료되면 알림이 중단됩니다. 작업표시줄 고정은 실행 아이콘을 오른쪽 클릭해 ‘작업 표시줄에 고정’을 선택하세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
     </StackPanel></Border>
     <Expander Header="연결 방식 안내" Margin="0,0,0,16"><ItemsControl x:Name="ProviderCards"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="20" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Prerequisites}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
     <TextBlock Text="설정·내 일정·암호화 계정 정보는 사용자 LocalAppData의 Moa 폴더에 보관됩니다. 업데이트·제거 시에도 개인 데이터는 유지합니다. 실제 메일·외부 일정은 메모리에서만 표시합니다." Foreground="{StaticResource Muted}" FontSize="12" Margin="4,0,4,16"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="3"><DockPanel Margin="3,10,0,0"><Button x:Name="CalendarCancel" DockPanel.Dock="Right" Content="취소" Click="CalendarCancel_Click" Padding="10,4" Visibility="Collapsed"/><TextBlock x:Name="CalendarSyncText" Text="캘린더 연결은 설정에서 추가하세요." FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="StatusText" Text="준비됨" FontSize="11" Foreground="{StaticResource Muted}" Margin="3,6,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
