<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\moa.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gather</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs;tools\**\*.cs;dist\**\*.cs;Evidence\**\*.cs" />
    <Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
    <Resource Include="Assets\moa.ico"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>
</Project>
